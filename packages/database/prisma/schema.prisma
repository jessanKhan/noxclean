datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  CLEANER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CLEANER_ASSIGNED
  CLEANER_ACCEPTED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  PAID
  CANCELLED
  REFUNDED
  FAILED_PAYMENT
  NO_SHOW
  DISPUTED
  REQUIRES_ADMIN_REVIEW
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  phone        String?
  role         UserRole      @default(CUSTOMER)
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  customerProfile CustomerProfile?
  cleanerProfile  CleanerProfile?
  addresses       Address[]
  auditLogs       AuditLog[]
  statusLogChanges BookingStatusLog[] @relation("ChangedBy")
}

model CustomerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookings Booking[]
  reviews  Review[]
}

model CleanerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  photoUrl           String?
  verificationStatus VerificationStatus @default(PENDING)
  hourlyRate         Float?
  ratingAvg          Float              @default(0.0)
  totalJobsCompleted Int                @default(0)
  serviceRadiusKm    Float              @default(10.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  documents    CleanerDocument[]
  availability CleanerAvailability[]
  bookings     Booking[]
  reviews      Review[]
}

model CleanerDocument {
  id                 String             @id @default(uuid())
  cleanerId          String
  cleaner            CleanerProfile     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  docType            String
  fileUrl            String
  verificationStatus VerificationStatus @default(PENDING)
  reviewerNotes      String?
  createdAt          DateTime           @default(now())
}

model CleanerAvailability {
  id        String         @id @default(uuid())
  cleanerId String
  cleaner   CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isAvailable Boolean      @default(true)
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  line1      String
  line2      String?
  city       String
  postcode   String
  country    String   @default("UK")
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  bookings Booking[]
}

model Service {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String
  basePrice    Float
  isFixedPrice Boolean  @default(false)
  minHours     Float    @default(2.0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addOns   AddOn[]
  bookings Booking[]
}

model AddOn {
  id              String   @id @default(uuid())
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Float
  durationMinutes Int      @default(30)
  isActive        Boolean  @default(true)

  bookingItems BookingItem[]
}

model Booking {
  id             String        @id @default(uuid())
  referenceCode  String        @unique
  customerId     String
  customer       CustomerProfile @relation(fields: [customerId], references: [id])
  cleanerId      String?
  cleaner        CleanerProfile? @relation(fields: [cleanerId], references: [id])
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])
  addressId      String
  address        Address       @relation(fields: [addressId], references: [id])
  scheduledDate  DateTime
  startTime      String
  durationHours  Float
  status         BookingStatus @default(PENDING)
  subtotal       Float
  travelFee      Float         @default(0.0)
  discountAmount Float         @default(0.0)
  taxAmount      Float         @default(0.0)
  totalAmount    Float
  instructions   String?
  completionPhotoUrl String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items       BookingItem[]
  statusLogs  BookingStatusLog[]
  payments    Payment[]
  invoices    Invoice[]
  reviews     Review[]
}

model BookingItem {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId   String
  addOn     AddOn   @relation(fields: [addOnId], references: [id])
  quantity  Int     @default(1)
  unitPrice Float
}

model BookingStatusLog {
  id             String        @id @default(uuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  previousStatus BookingStatus?
  newStatus      BookingStatus
  changedById    String?
  changedBy      User?         @relation("ChangedBy", fields: [changedById], references: [id])
  notes          String?
  createdAt      DateTime      @default(now())
}

model Payment {
  id                   String        @id @default(uuid())
  bookingId            String
  booking              Booking       @relation(fields: [bookingId], references: [id])
  stripePaymentIntentId String?      @unique
  amount               Float
  currency             String        @default("GBP")
  status               PaymentStatus @default(PENDING)
  createdAt            DateTime      @default(now())
}

model Invoice {
  id            String   @id @default(uuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id])
  invoiceNumber String   @unique
  pdfUrl        String?
  amount        Float
  issuedAt      DateTime @default(now())
}

model Review {
  id         String          @id @default(uuid())
  bookingId  String          @unique
  booking    Booking         @relation(fields: [bookingId], references: [id])
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id])
  cleanerId  String
  cleaner    CleanerProfile  @relation(fields: [cleanerId], references: [id])
  rating     Int
  comment    String?
  isApproved Boolean         @default(true)
  createdAt  DateTime        @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  action       String
  targetEntity String
  targetId     String?
  detailsJson  String?
  ipAddress    String?
  createdAt    DateTime @default(now())
}

model CmsContent {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String
  contentJson String
  updatedAt   DateTime @updatedAt
}
